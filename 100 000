<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>100 000 FCFA/mois Sans Pub — Système Fahaldine</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
  :root {
    --primary: #1a5fb4;
    --primary-light: #3584e4;
    --primary-dark: #0d3b7a;
    --accent: #e66100;
    --accent-light: #ff7800;
    --bg: #ffffff;
    --bg-soft: #f6f8fc;
    --bg-card: #ffffff;
    --text: #1a1a2e;
    --text-secondary: #4a4a5a;
    --text-muted: #7a7a8a;
    --border: #e2e6ef;
    --border-light: #f0f2f7;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.04);
    --shadow-md: 0 4px 20px rgba(0,0,0,0.06);
    --shadow-lg: 0 8px 40px rgba(0,0,0,0.08);
    --shadow-accent: 0 4px 20px rgba(26,95,180,0.15);
    --radius: 12px;
    --radius-sm: 8px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* ========== ANIMATIONS ========== */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideInLeft {
    from { opacity: 0; transform: translateX(-30px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  @keyframes shimmer {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes scaleIn {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }

  .anim-fade-up {
    opacity: 0;
    animation: fadeInUp 0.7s ease forwards;
  }

  .anim-fade {
    opacity: 0;
    animation: fadeIn 0.6s ease forwards;
  }

  .anim-slide-left {
    opacity: 0;
    animation: slideInLeft 0.7s ease forwards;
  }

  .anim-slide-right {
    opacity: 0;
    animation: slideInRight 0.7s ease forwards;
  }

  .anim-scale {
    opacity: 0;
    animation: scaleIn 0.6s ease forwards;
  }

  .delay-1 { animation-delay: 0.1s; }
  .delay-2 { animation-delay: 0.2s; }
  .delay-3 { animation-delay: 0.3s; }
  .delay-4 { animation-delay: 0.4s; }
  .delay-5 { animation-delay: 0.5s; }
  .delay-6 { animation-delay: 0.6s; }

  /* ========== STICKY HEADER ========== */
  .sticky-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    z-index: 1000;
    transition: all 0.3s ease;
  }

  .sticky-header.scrolled {
    box-shadow: var(--shadow-md);
    padding: 10px 24px;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 15px;
    color: var(--text);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .header-brand:hover {
    color: var(--primary);
    transform: translateY(-1px);
  }

  .header-brand .emoji {
    font-size: 20px;
    animation: float 3s ease-in-out infinite;
  }

  .header-nav {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .header-nav a {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }

  .header-nav a::after {
    content: '';
    position: absolute;
    bottom: 0; left: 50%;
    width: 0; height: 2px;
    background: var(--primary);
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }

  .header-nav a:hover {
    color: var(--primary);
    background: var(--bg-soft);
    transform: translateY(-2px);
  }

  .header-nav a:hover::after {
    width: 60%;
  }

  .header-cta {
    background: var(--primary);
    color: white !important;
    font-weight: 700;
    padding: 10px 20px !important;
    border-radius: var(--radius-sm);
    transition: all 0.3s ease;
    box-shadow: var(--shadow-accent);
  }

  .header-cta:hover {
    background: var(--primary-dark) !important;
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 6px 24px rgba(26,95,180,0.25);
  }

  .header-cta::after { display: none !important; }

  @media (max-width: 768px) {
    .header-nav { display: none; }
    .sticky-header { justify-content: center; }
  }

  /* ========== HERO ========== */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 140px 24px 80px;
    position: relative;
    background: linear-gradient(180deg, var(--bg-soft) 0%, var(--bg) 60%);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background: radial-gradient(ellipse at 30% 20%, rgba(26,95,180,0.06) 0%, transparent 50%),
                 radial-gradient(ellipse at 70% 80%, rgba(230,97,0,0.04) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--bg);
    border: 1.5px solid var(--border);
    color: var(--primary);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 10px 22px;
    border-radius: 50px;
    margin-bottom: 36px;
    box-shadow: var(--shadow-sm);
    animation: fadeIn 0.8s ease both, float 4s ease-in-out infinite 1s;
  }

  .hero-badge .dot {
    width: 8px; height: 8px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  .hero-title {
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -2px;
    margin-bottom: 16px;
    color: var(--text);
    max-width: 900px;
  }

  .hero-title .highlight {
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    position: relative;
  }

  .hero-title .sub {
    font-size: 0.45em;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.5px;
    display: block;
    margin-top: 12px;
    line-height: 1.4;
  }

  .hero-subtitle {
    font-size: clamp(18px, 2.2vw, 24px);
    color: var(--text-secondary);
    font-weight: 500;
    margin-bottom: 28px;
    max-width: 600px;
  }

  .hero-desc {
    max-width: 620px;
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.8;
    margin-bottom: 44px;
  }

  .cta-main {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    font-weight: 700;
    font-size: 17px;
    padding: 18px 40px;
    border-radius: var(--radius);
    text-decoration: none;
    letter-spacing: 0.3px;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: var(--shadow-accent);
    position: relative;
    overflow: hidden;
  }

  .cta-main::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    background-size: 200% 100%;
    animation: shimmer 3s infinite;
  }

  .cta-main:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 48px rgba(26,95,180,0.3);
  }

  .cta-main:active {
    transform: translateY(-1px) scale(0.98);
  }

  .hero-price-tag {
    margin-top: 20px;
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .hero-price-tag strong {
    color: var(--accent);
    font-weight: 700;
  }

  .hero-stats {
    display: flex;
    gap: 48px;
    margin-top: 60px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-stat {
    text-align: center;
    animation: fadeInUp 0.6s ease both;
  }

  .hero-stat-num {
    font-size: 32px;
    font-weight: 900;
    color: var(--primary);
    line-height: 1;
  }

  .hero-stat-label {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 6px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* ========== SECTIONS ========== */
  section { padding: 100px 24px; position: relative; }

  .container { max-width: 800px; margin: 0 auto; }
  .container-wide { max-width: 1100px; margin: 0 auto; }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 20px;
    padding: 6px 14px;
    background: rgba(26,95,180,0.08);
    border-radius: 50px;
  }

  .section-title {
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1px;
    margin-bottom: 24px;
    color: var(--text);
  }

  .section-title em {
    font-style: normal;
    color: var(--primary);
    position: relative;
  }

  .section-title em::after {
    content: '';
    position: absolute;
    bottom: 2px; left: 0; right: 0;
    height: 8px;
    background: rgba(26,95,180,0.12);
    border-radius: 4px;
    z-index: -1;
  }

  .section-desc {
    font-size: 17px;
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 600px;
  }

  /* ========== PAIN SECTION ========== */
  .pain {
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .pain-question {
    font-size: 18px;
    color: var(--text-secondary);
    font-weight: 600;
    margin: 24px 0 32px;
    padding: 16px 24px;
    background: white;
    border-left: 4px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    box-shadow: var(--shadow-sm);
    animation: slideInLeft 0.6s ease both 0.3s;
  }

  .pain-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 20px;
  }

  .pain-list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 24px;
    background: white;
    border-radius: var(--radius-sm);
    font-size: 15px;
    color: var(--text-secondary);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    transition: all 0.3s ease;
    animation: fadeInUp 0.5s ease both;
  }

  .pain-list li:nth-child(1) { animation-delay: 0.1s; }
  .pain-list li:nth-child(2) { animation-delay: 0.2s; }
  .pain-list li:nth-child(3) { animation-delay: 0.3s; }
  .pain-list li:nth-child(4) { animation-delay: 0.4s; }
  .pain-list li:nth-child(5) { animation-delay: 0.5s; }
  .pain-list li:nth-child(6) { animation-delay: 0.6s; }

  .pain-list li:hover {
    transform: translateX(6px);
    box-shadow: var(--shadow-md);
    border-color: var(--border);
  }

  .pain-list li::before {
    content: '✗';
    color: var(--accent);
    font-weight: 800;
    font-size: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(230,97,0,0.08);
    border-radius: 50%;
  }

  /* ========== PROMISE ========== */
  .promise {
    text-align: center;
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg-soft) 100%);
  }

  .big-quote {
    font-size: clamp(22px, 3vw, 34px);
    font-weight: 600;
    font-style: italic;
    line-height: 1.5;
    color: var(--text);
    max-width: 800px;
    margin: 0 auto 32px;
    position: relative;
    padding: 0 20px;
  }

  .big-quote::before {
    content: '"';
    position: absolute;
    top: -40px;
    left: -10px;
    font-size: 120px;
    color: rgba(26,95,180,0.08);
    font-weight: 900;
    line-height: 1;
    font-family: Georgia, serif;
  }

  .quote-author {
    color: var(--primary);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  /* ========== WHAT IS ========== */
  .what-is { background: var(--bg); }

  .what-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 52px;
  }

  @media (max-width: 900px) {
    .what-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .what-grid { grid-template-columns: 1fr; }
  }

  .what-card {
    background: var(--bg-card);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 36px 28px;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
    animation: fadeInUp 0.6s ease both;
  }

  .what-card:nth-child(1) { animation-delay: 0.1s; }
  .what-card:nth-child(2) { animation-delay: 0.2s; }
  .what-card:nth-child(3) { animation-delay: 0.3s; }
  .what-card:nth-child(4) { animation-delay: 0.4s; }
  .what-card:nth-child(5) { animation-delay: 0.5s; }
  .what-card:nth-child(6) { animation-delay: 0.6s; }

  .what-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary), var(--primary-light));
    transform: scaleX(0);
    transition: transform 0.4s ease;
  }

  .what-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary);
  }

  .what-card:hover::before {
    transform: scaleX(1);
  }

  .what-card .icon {
    font-size: 36px;
    margin-bottom: 20px;
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .what-card:hover .icon {
    transform: scale(1.15) rotate(-5deg);
  }

  .what-card h3 {
    font-size: 18px;
    font-weight: 800;
    margin-bottom: 12px;
    color: var(--text);
  }

  .what-card p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* ========== CHAPTERS ========== */
  .chapters { background: var(--bg-soft); }

  .chapter-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 52px;
    background: white;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border);
  }

  .chapter-item {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    padding: 28px 32px;
    border-bottom: 1px solid var(--border-light);
    transition: all 0.3s ease;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    animation: fadeInUp 0.5s ease both;
  }

  .chapter-item:nth-child(1) { animation-delay: 0.05s; }
  .chapter-item:nth-child(2) { animation-delay: 0.1s; }
  .chapter-item:nth-child(3) { animation-delay: 0.15s; }
  .chapter-item:nth-child(4) { animation-delay: 0.2s; }
  .chapter-item:nth-child(5) { animation-delay: 0.25s; }
  .chapter-item:nth-child(6) { animation-delay: 0.3s; }
  .chapter-item:nth-child(7) { animation-delay: 0.35s; }

  .chapter-item:last-child { border-bottom: none; }

  .chapter-item:hover {
    background: var(--bg-soft);
    padding-left: 40px;
  }

  .chapter-num {
    font-size: 32px;
    font-weight: 900;
    color: var(--primary);
    line-height: 1;
    flex-shrink: 0;
    width: 48px;
    opacity: 0.3;
    transition: all 0.3s ease;
  }

  .chapter-item:hover .chapter-num {
    opacity: 1;
    transform: scale(1.1);
  }

  .chapter-content h4 {
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
    transition: color 0.3s ease;
  }

  .chapter-item:hover .chapter-content h4 {
    color: var(--primary);
  }

  .chapter-content p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ========== FOR WHO ========== */
  .for-who { background: var(--bg); }

  .who-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 52px;
  }

  @media (max-width: 700px) {
    .who-grid { grid-template-columns: 1fr; }
  }

  .who-yes, .who-no {
    border-radius: var(--radius);
    padding: 36px 32px;
    transition: all 0.3s ease;
  }

  .who-yes {
    background: linear-gradient(135deg, rgba(26,95,180,0.04), rgba(26,95,180,0.02));
    border: 2px solid rgba(26,95,180,0.15);
  }

  .who-no {
    background: linear-gradient(135deg, rgba(230,97,0,0.03), rgba(230,97,0,0.01));
    border: 2px solid rgba(230,97,0,0.1);
  }

  .who-yes:hover, .who-no:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .who-yes h3 {
    color: var(--primary);
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 24px;
    font-weight: 800;
  }

  .who-no h3 {
    color: var(--accent);
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 24px;
    font-weight: 800;
  }

  .who-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .who-list li {
    font-size: 15px;
    color: var(--text-secondary);
    padding-left: 28px;
    position: relative;
    line-height: 1.5;
    transition: all 0.2s ease;
  }

  .who-list li:hover {
    transform: translateX(4px);
  }

  .who-yes .who-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--primary);
    font-weight: 800;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(26,95,180,0.1);
    border-radius: 50%;
    font-size: 11px;
  }

  .who-no .who-list li::before {
    content: '✗';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 800;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(230,97,0,0.1);
    border-radius: 50%;
    font-size: 11px;
  }

  /* ========== AUTHOR ========== */
  .author {
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .author-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 48px;
    align-items: center;
  }

  @media (max-width: 700px) {
    .author-inner { grid-template-columns: 1fr; text-align: center; }
    .author-stats { justify-content: center; }
  }

  .author-avatar {
    width: 140px;
    height: 140px;
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 64px;
    box-shadow: var(--shadow-accent);
    animation: float 4s ease-in-out infinite;
    flex-shrink: 0;
    overflow: hidden;
    border: 3px solid var(--border);
    transition: all 0.3s ease;
  }

  .author-avatar:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 32px rgba(26,95,180,0.3);
    border-color: var(--primary);
  }

  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .author-name {
    font-size: 36px;
